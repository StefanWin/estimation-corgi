{
  "name": "estimation-corgi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start \"vite dev\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "types": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write",
    "convex:migrate": "convex run --prod convex/migrations.ts:runAll",
    "deploy:convex": "convex deploy && pnpm run convex:migrate && pnpm run deploy"
  },
  "dependencies": {
    "@convex-dev/migrations": "0.3.6",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@marsidev/react-turnstile": "1.6.1",
    "@mui/material": "9.4.0",
    "convex": "1.46.0",
    "lucide-react": "1.47.0",
    "posthog-js": "1.433.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "1.56.0",
    "@cloudflare/workers-types": "5.20260919.1",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.135.0"
  },
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.14.0"
  }
}
