    "@fontsource-variable/geist-mono": "5.3.0",
    "@marsidev/react-turnstile": "1.6.0",
    "@mui/material": "9.3.1",
    "convex": "1.44.0",
    "lucide-react": "1.32.0",
    "posthog-js": "1.418.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "2.0.8",
    "zod": "4.4.3"
