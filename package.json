{
  "name": "estimation-corgi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "convex dev --start \"cf dev\"",
    "build": "pnpm run types && cf build",
    "preview": "vite preview",
    "deploy": "cf deploy --prebuilt",
    "types": "cf workers types && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write",
    "convex:migrate": "convex run --prod convex/migrations.ts:runAll",
    "deploy:convex": "convex deploy && pnpm run convex:migrate && pnpm run deploy"
  },
  "dependencies": {
    "@cf-wasm/og": "0.5.0",
    "@convex-dev/migrations": "0.3.7",
    "@convex-dev/rate-limiter": "0.4.2",
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@jsquash/png": "3.1.1",
    "@jsquash/webp": "1.5.0",
    "@marsidev/react-turnstile": "1.6.3",
    "@mui/material": "9.5.0",
    "convex": "1.48.0",
    "lucide-react": "1.61.0",
    "posthog-js": "1.438.19",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vite-plugin": "2.0.0-beta.v.4",
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "cf": "1.0.0-beta.21",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": "22.x"
  }
}
